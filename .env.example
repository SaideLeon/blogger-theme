# Qualquer servidor compatível com a API "chat completions" da OpenAI
# (OpenRouter, Groq, Together, Fireworks, Cerebras, Ollama, vLLM...)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=coloque-aqui-a-chave
LLM_MODEL=openai/gpt-oss-120b
# Orçamento de contexto enviado por pedido (em tokens estimados). O gpt-oss aceita ~128k;
# manter baixo poupa dinheiro e latência.
CONTEXT_BUDGET_TOKENS=24000
